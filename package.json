{
  "name": "digigrantha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"try { require('child_process').execSync('prisma generate', {stdio: 'inherit'}) } catch (e) { console.log('Using existing Prisma Client') }\" && next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare preview",
    "deploy:worker": "opennextjs-cloudflare build && wrangler deploy --keep-vars",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@opennextjs/cloudflare": "^1.20.13",
    "@prisma/adapter-neon": "^6.19.3",
    "@prisma/client": "^6.4.1",
    "@types/nodemailer": "^8.0.1",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "jose": "^5.9.6",
    "next": "^15.2.0",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/ws": "^8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.154.0"
  }
}
