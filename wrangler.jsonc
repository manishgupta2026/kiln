{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digigrantha",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "vars": {
    "SMTP_HOST": "smtp.zoho.in",
    "SMTP_PORT": "465",
    "SMTP_USER": "team@digigrantha.com",
    "FROM_EMAIL": "Digigrantha <team@digigrantha.com>"
  }
}