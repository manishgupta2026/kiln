DIRECT_URL="postgresql://user:password@host.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
JWT_SECRET="replace-with-a-secure-random-64-character-hex-string"

# Email Configuration (Choose your preferred provider):

# Option 1: Zoho Work Mail SMTP (Recommended for custom domain emails)
SMTP_HOST="smtppro.zoho.in"       # Use "smtppro.zoho.com" if your Zoho account is on .com
SMTP_PORT="465"                   # SSL port (465) or TLS port (587)
SMTP_USER="team@digigrantha.com"  # Your Zoho work email address
SMTP_PASS="xxxx xxxx xxxx xxxx"   # Zoho Application-Specific Password (App Password)
FROM_EMAIL="Digigrantha <team@digigrantha.com>"

# Option 2: Gmail SMTP
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Option 3: Resend API
RESEND_API_KEY=""
